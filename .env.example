# App — use full URL with https:// in production (required for SEO / Open Graph)
NEXT_PUBLIC_APP_URL=https://localhost:3000

# Supabase Storage: create public bucket "animal-media"
# Dashboard → Storage → New bucket → name: animal-media → Public Auth redirect (Dashboard → Auth → URL Configuration):
# http://localhost:3000/**
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supabase PostgreSQL)
# Get both from: Supabase Dashboard → Project Settings → Database → Connect
#
# DATABASE_URL = "Transaction pooler" (port 6543) — for production / serverless
# Username MUST be postgres.YOUR_PROJECT_REF (not just postgres)
# Region example: West EU (Ireland) = eu-west-1 (check Dashboard or `supabase projects list`)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# DIRECT_URL = "Session pooler" (port 5432) — for prisma migrate only
# Optional override if 6543 fails locally: PRISMA_DATABASE_URL="..."
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Admin emails (comma-separated) — auto-grant ADMIN role on login
ADMIN_EMAILS=admin@kotoxata.org

# Telegram (Phase 1)
TELEGRAM_SPONSOR_BOT_TOKEN=
TELEGRAM_VOLUNTEER_BOT_TOKEN=
TELEGRAM_SPONSOR_WEBHOOK_SECRET=
TELEGRAM_VOLUNTEER_WEBHOOK_SECRET=

# AI (Phase 1)
OPENAI_API_KEY=
